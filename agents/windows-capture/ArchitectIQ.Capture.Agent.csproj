<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ArchitectIQ.Capture.Agent</AssemblyName>
    <RootNamespace>ArchitectIQ.Capture.Agent</RootNamespace>
    <Version>1.0.0</Version>
    <Company>ArchitectIQ</Company>
    <Product>ArchitectIQ Process Capture Agent</Product>
    <Description>Enterprise-governed native Windows recording engine for ArchitectIQ Process Capture Studio</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

</Project>
