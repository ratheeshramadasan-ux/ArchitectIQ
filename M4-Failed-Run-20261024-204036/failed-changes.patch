 )
 
+def stop_execution(message: str = "Security STOP executed"):
+    """Emergency shutdown function for critical security issues.
+
+    This function terminates the application immediately with a critical error
+    message, intended for emergency situations where continued execution poses
+    a security risk.
+
+    Args:
+        message (str): The error message to log and display
+    """
+    print(f"SECURITY STOP: {message}", file=sys.stderr)
+    sys.exit(1)
+
+# Add the stop function to app state so it's accessible from other modules if needed
+app.state.stop_execution = stop_execution
+
 
