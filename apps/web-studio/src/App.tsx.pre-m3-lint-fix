 {search&&<div className="search-overlay" onMouseDown={e=>{if(e.target===e.currentTarget)setSearch(false)}}><div className="search-dialog glass" role="dialog" aria-modal="true" aria-label="Search navigation"><div className="search-input-wrap"><Search size={21}/><input autoFocus aria-label="Search studios and pages" placeholder="Search modules and pages..." value={query} onChange={e=>setQuery(e.target.value)}/><button className="escape-key" onClick={()=>setSearch(false)}>ESC</button></div><div className="search-results">{matches.length?matches.map(({name,icon:Icon})=><button key={name} onClick={()=>navigate(name)}><Icon size={18}/>{name}<ArrowRight size={16}/></button>):<p>No matching pages found.</p>}</div><div className="search-footer">ArchitectIQ Enterprise Workspace</div></div></div>}</div>
