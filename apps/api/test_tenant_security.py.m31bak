from sqlalchemy import text

from database import RuntimeSessionLocal


def test_missing_tenant_context_exposes_no_records():
    tables = (
        "tenants",
        "organizations",
        "folders",
        "projects",
        "project_environments",
    )

    with RuntimeSessionLocal() as session:
        with session.begin():
            assert session.scalar(
                text("SELECT current_user")
            ) == "architectiq_app"

            context = session.scalar(
                text(
                    "SELECT current_setting("
                    "'architectiq.tenant_id', true)"
                )
            )
            assert context in (None, "")

            for table in tables:
                count = session.scalar(
                    text(f"SELECT COUNT(*) FROM public.{table}")
                )
                assert count == 0, (
                    f"{table} exposed {count} rows "
                    "without tenant context"
                )
from uuid import UUID

from sqlalchemy import text
from database import tenant_session

TENANT_A = UUID("11111111-1111-4111-8111-111111111111")
TENANT_B = UUID("22222222-2222-4222-8222-222222222222")

import pytest
from uuid import uuid5

def _fixture_id(tenant_id, kind):
    return uuid5(tenant_id, f"m31-isolation-{kind}")

@pytest.fixture(scope="module", autouse=True)
def isolated_tenant_hierarchies():
    """Seed both test tenants; remove only rows created by this fixture."""
    from sqlalchemy.engine import make_url
    from settings import get_settings
    from database import engine

    assert make_url(get_settings().database_url).database == "architectiq_test"
    tenants = (TENANT_A, TENANT_B)
    tables = ("tenants", "organizations", "folders", "projects", "project_environments")
    ids = {
        tid: {kind: _fixture_id(tid, kind) for kind in tables if kind != "tenants"}
        for tid in tenants
    }
    with engine.begin() as conn:
        assert conn.scalar(text("SELECT current_database()")) == "architectiq_test"
        for tid in tenants:
            # Never overwrite or delete pre-existing records.
            existing = conn.scalar(text("SELECT COUNT(*) FROM public.tenants WHERE id=:id"), {"id": tid})
            assert existing == 0, f"Fixture tenant already exists: {tid}"
        for tid in tenants:
            d = ids[tid]
            conn.execute(text("INSERT INTO public.tenants (id,name,slug,created_at) VALUES (:id,:name,:slug,now())"),
                         {"id":tid,"name":"M31 isolation fixture","slug":f"m31-{tid}"})
            conn.execute(text("INSERT INTO public.organizations (id,tenant_id,name,slug,created_at) VALUES (:id,:tenant,'M31 Org','m31',now())"),
                         {"id":d["organizations"],"tenant":tid})
            conn.execute(text("INSERT INTO public.folders (id,organization_id,name,created_at) VALUES (:id,:org,'M31 Folder',now())"),
                         {"id":d["folders"],"org":d["organizations"]})
            conn.execute(text("INSERT INTO public.projects (id,folder_id,name,created_at) VALUES (:id,:folder,'M31 Project',now())"),
                         {"id":d["projects"],"folder":d["folders"]})
            conn.execute(text("INSERT INTO public.project_environments (id,project_id,environment,created_at) VALUES (:id,:project,'TEST',now())"),
                         {"id":d["project_environments"],"project":d["projects"]})
    try:
        yield
    finally:
        # Never delete by tenant alone; target only deterministic fixture IDs.
        with engine.begin() as conn:
            assert conn.scalar(text("SELECT current_database()")) == "architectiq_test"
            for tid in tenants:
                d=ids[tid]
                for table in ("project_environments","projects","folders","organizations"):
                    conn.execute(text(f"DELETE FROM public.{table} WHERE id=:id"), {"id":d[table]})
                conn.execute(text("DELETE FROM public.tenants WHERE id=:id"), {"id":tid})




def test_cross_tenant_rls_isolation():
    tables = (
        "tenants",
        "organizations",
        "folders",
        "projects",
        "project_environments",
    )

    def visible_ids(tenant_id):
        results = {}

        with tenant_session(tenant_id) as session:
            assert session.scalar(
                text("SELECT current_user")
            ) == "architectiq_app"

            for table in tables:
                results[table] = set(
                    session.execute(
                        text(f"SELECT id FROM public.{table}")
                    ).scalars().all()
                )

        return results

    tenant_a = visible_ids(TENANT_A)
    tenant_b = visible_ids(TENANT_B)

    for table in tables:
        assert tenant_a[table], (
            f"Tenant A has no test records in {table}"
        )

        assert tenant_b[table], (
            f"Tenant B has no test records in {table}"
        )

        assert tenant_a[table].isdisjoint(tenant_b[table]), (
            f"Cross-tenant exposure detected in {table}"
        )
from database import engine


def test_visible_records_have_correct_tenant_ownership():
    ownership_queries = {
        "tenants": """
            SELECT id, id AS owner_tenant_id
            FROM public.tenants
        """,
        "organizations": """
            SELECT id, tenant_id AS owner_tenant_id
            FROM public.organizations
        """,
        "folders": """
            SELECT f.id, o.tenant_id AS owner_tenant_id
            FROM public.folders f
            JOIN public.organizations o
              ON o.id = f.organization_id
        """,
        "projects": """
            SELECT p.id, o.tenant_id AS owner_tenant_id
            FROM public.projects p
            JOIN public.folders f ON f.id = p.folder_id
            JOIN public.organizations o
              ON o.id = f.organization_id
        """,
        "project_environments": """
            SELECT pe.id, o.tenant_id AS owner_tenant_id
            FROM public.project_environments pe
            JOIN public.projects p ON p.id = pe.project_id
            JOIN public.folders f ON f.id = p.folder_id
            JOIN public.organizations o
              ON o.id = f.organization_id
        """,
    }

    # Admin connection is used only to establish authoritative
    # ownership, not to test tenant-restricted visibility.
    with engine.connect() as admin:
        ownership = {
            table: {
                row.id: row.owner_tenant_id
                for row in admin.execute(text(query))
            }
            for table, query in ownership_queries.items()
        }

    for tenant_id in (TENANT_A, TENANT_B):
        with tenant_session(tenant_id) as session:
            for table in ownership_queries:
                visible_ids = session.execute(
                    text(f"SELECT id FROM public.{table}")
                ).scalars().all()

                assert visible_ids, (
                    f"No fixture records for {table}"
                )

                for record_id in visible_ids:
                    assert ownership[table][record_id] == tenant_id, (
                        f"SECURITY FAILURE: {table} record "
                        f"{record_id} belongs to another tenant"
                    )
